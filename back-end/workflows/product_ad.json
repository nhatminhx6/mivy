{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "dreamshaper_8.safetensors"}
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{INPUT_IMAGE}}"}
  },
  "3": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {"pixels": ["9", 0], "vae": ["1", 2], "mask": ["10", 1], "grow_mask_by": 4}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{PROMPT}}", "clip": ["1", 1]}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "person, people, human, man, woman, girl, boy, hand, hands, arm, fingers, face, body, legs, feet, model, mannequin, doll, portrait, podium, pedestal, stand, platform, stage, bowl, plate, box, extra objects, clutter, duplicate subject, blurry, low quality, watermark, text, letters",
      "clip": ["1", 1]
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 84739201,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["3", 0]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["6", 0], "vae": ["1", 2]}
  },
  "9": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["2", 0],
      "upscale_method": "lanczos",
      "width": 512,
      "height": 512,
      "crop": "center"
    }
  },
  "10": {
    "class_type": "MivyProductMask",
    "inputs": {"image": ["9", 0]}
  },
  "11": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["7", 0],
      "source": ["9", 0],
      "mask": ["10", 0],
      "x": 0,
      "y": 0,
      "resize_source": false
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "{{OUTPUT_PREFIX}}", "images": ["11", 0]}
  }
}
