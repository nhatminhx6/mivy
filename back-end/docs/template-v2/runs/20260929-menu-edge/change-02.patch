+    const measureWrap = (text: string, size: number, maxWidth: number) => {
+      ctx.font = `500 ${size}px sans-serif`;
+      const words = text.split(' ');
+      let lines = [];
+      let currentLine = words[0] || '';
+      for (let i = 1; i < words.length; i++) {
+        const word = words[i];
+        const width = ctx.measureText(currentLine + " " + word).width;
+        if (width < maxWidth) {
+          currentLine += " " + word;
+        } else {
+          lines.push(currentLine);
+          currentLine = word;
+        }
+      }
+      if (currentLine) lines.push(currentLine);
+      return lines;
+    };
+
+    const sizes = [w * 0.045, w * 0.035];
+    let finalLayout: { lines: string[], height: number }[] = [];
+    let finalSize = sizes[1];
+    let hiddenCount = 0;
+    
+    for (const size of sizes) {
+      ctx.font = `500 ${size}px sans-serif`;
+      const lineHeight = size * 1.4;
+      const padding = size * 1.0;
+      let currentH = 0;
+      let tempLayout = [];
+      let tempHidden = 0;
+      const maxListH = (h - inset * 3) - listTop - (size * 4);
+      
+      for (let i = 0; i < allPoints.length; i++) {
+        const lines = measureWrap(allPoints[i], size, w - inset * 4);
+        const itemH = lines.length * lineHeight;
+        const padH = tempLayout.length > 0 ? padding : 0;
+        const needsCue = (i < allPoints.length - 1);
+        const cueH = needsCue ? size * 3.0 : 0;
+        
+        if (currentH + itemH + padH + cueH <= maxListH) {
+          currentH += itemH + padH;
+          tempLayout.push({ lines, height: itemH });
+        } else {
+          tempHidden = allPoints.length - i;
+          break;
+        }
+      }
+      
+      if (tempHidden === 0 || size === sizes[1]) {
+        finalLayout = tempLayout;
+        finalSize = size;
+        hiddenCount = tempHidden;
+        if (tempHidden === 0) break;
+      }
+    }
+    
+    let currentY = listTop;
+    const lineHeight = finalSize * 1.4;
+    
+    ctx.textBaseline = 'top';
+    finalLayout.forEach((item, i) => {
