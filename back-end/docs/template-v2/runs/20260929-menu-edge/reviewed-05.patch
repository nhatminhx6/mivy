+          fullLayout.push({ lines, height: itemH });
+        } else {
+          allFit = false;
+          break;
+        }
+      }
+      
+      if (allFit) {
+        finalLayout = fullLayout;
+        finalSize = size;
+        hiddenCount = 0;
+        break;
+      }
+      
+      let tempLayout = [];
+      let currentH = 0;
+      let tempHidden = 0;
+      const cueH = size * 3.0;
+      
+      for (let i = 0; i < allPoints.length; i++) {
+        const lines = measureWrap(allPoints[i], size, w - inset * 4);
+        const itemH = lines.length * lineHeight;
