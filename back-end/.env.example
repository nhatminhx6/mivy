APP_NAME=mivy-backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/mivy.db
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_SIZE_MB=25
GENERATION_ENGINE=mock
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/product_ad.json
GENERATION_TIMEOUT_SECONDS=600

VISUAL_ENGINE=pollinations
POLLINATIONS_BASE_URL=https://image.pollinations.ai
# Token provider gen ảnh — để trống dùng free; thay REPLACE_ME bằng key thật khi có
IMAGE_GEN_TOKEN=REPLACE_ME

OLLAMA_BASE_URL=http://127.0.0.1:11434
TEXT_MODEL=qwen3:8b
TEXT_TIMEOUT_SECONDS=300

PRODUCT_PYTHON=.comfyui/.venv/bin/python
PRODUCT_MODEL_HOME=.comfyui/models/rembg
PRODUCT_CACHE_DIR=data/cutout_cache
PRODUCT_MODEL=birefnet-general

# ---- Tài khoản + ví ----
# Email admin (cách nhau dấu phẩy). PHẢI có email của anh thì /studio/admin mới mở được.
ADMIN_EMAILS=minh.nn1@pharmacity.vn
SIGNUP_BONUS=2
SESSION_DAYS=30
COOKIE_SECURE=false   # bật true khi chạy https thật

# ---- Đơn in: báo admin khi có đơn mới (để trống = không báo, phải tự mở /studio/admin) ----
# Lấy token: nhắn @BotFather trên Telegram → /newbot. Lấy chat id: nhắn bot 1 câu rồi mở
# https://api.telegram.org/bot<token>/getUpdates, copy số "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=   # vd https://mivy.vn — gắn link trang quản trị vào tin báo
PRINT_DIR=./data/print_orders
