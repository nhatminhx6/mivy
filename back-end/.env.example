APP_NAME=mivy-backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/mivy.db
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_SIZE_MB=25
GENERATION_ENGINE=mock
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/product_ad.json
GENERATION_TIMEOUT_SECONDS=600

VISUAL_ENGINE=pollinations
POLLINATIONS_BASE_URL=https://image.pollinations.ai

OLLAMA_BASE_URL=http://127.0.0.1:11434
TEXT_MODEL=qwen3:8b
TEXT_TIMEOUT_SECONDS=300

PRODUCT_PYTHON=.comfyui/.venv/bin/python
PRODUCT_MODEL_HOME=.comfyui/models/rembg
PRODUCT_CACHE_DIR=data/cutout_cache
PRODUCT_MODEL=birefnet-general
