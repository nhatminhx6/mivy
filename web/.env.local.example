# Web (Next.js) — copy file này thành .env.local rồi điền. Mọi biến NEXT_PUBLIC_* lộ ra trình duyệt,
# chỉ để giá trị công khai (số tài khoản nhận tiền thì được, KHÔNG để secret/API key bí mật ở đây).

# ---- Ngân hàng nhận cọc + nạp ví (VietQR) ----
# BANK_BIN: mã ngân hàng VietQR — số BIN (vd 970436 = Vietcombank) HOẶC mã ngắn (vcb, mbbank, tcb, acb…).
# Dùng CHUNG cho cả trang đơn in (QR cọc) lẫn ví. Thiếu biến này → khách KHÔNG thấy QR để chuyển tiền.
NEXT_PUBLIC_BANK_BIN=
NEXT_PUBLIC_BANK_ACCOUNT=     # số tài khoản nhận tiền
NEXT_PUBLIC_BANK_NAME=        # tên hiển thị, vd Vietcombank
NEXT_PUBLIC_BANK_OWNER=       # tên chủ tài khoản (IN HOA không dấu, đúng như ngân hàng)
NEXT_PUBLIC_TOPUP_CONTACT=    # (tuỳ chọn) Zalo/SĐT hỗ trợ khi khách nạp gấp

# ---- Liên hệ Mivy cho khách (đặt in theo yêu cầu) ----
# Số Zalo/SĐT công khai của Mivy. Có giá trị → trang chủ + trang "Đặt in theo yêu cầu" hiện nút "Nhắn Zalo".
# Để trống cũng được — khách vẫn gửi yêu cầu qua form (tạo đơn như thường).
NEXT_PUBLIC_MIVY_ZALO=

# ---- Ảnh nền template (đã dùng) ----
PIXABAY_API_KEY=
